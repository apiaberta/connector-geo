PORT=3009
NODE_ENV=production
MONGO_URI=mongodb://localhost:27017/apiaberta-geo

# geoapi.pt origin. Tests and dev must never point MONGO_URI at production.
GEO_API_BASE=https://geoapi.pt

# Daily ingest at 04:45 Europe/Lisbon so it does not overlap connector-base (03:00)
# or connector-gtfs (03:30). CAOP geometry is refreshed at most every SYNC_REFRESH_DAYS.
SYNC_CRON=45 4 * * *
SYNC_TZ=Europe/Lisbon
SYNC_REFRESH_DAYS=7
SYNC_CONCURRENCY=2
SYNC_FETCH_TIMEOUT_MS=60000
SYNC_PARISH_BATCH=200
# auto (unset): ingest on startup only if last_sync is older than SYNC_STARTUP_MAX_AGE_HOURS.
# 1 = always, 0 = never. SYNC_FULL=1 forces a geometry refetch (ignores SYNC_REFRESH_DAYS).
SYNC_ON_STARTUP=
SYNC_STARTUP_MAX_AGE_HOURS=24
SYNC_FULL=

# In-memory HTTP cache. GeoJSON responses are never stored (max value 64 KiB).
CACHE_MAX_ENTRIES=250
CACHE_MAX_BYTES=1048576
CACHE_MAX_VALUE_BYTES=65536
